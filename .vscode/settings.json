{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "code-runner.runInTerminal": true,
  "code-runner.ignoreSelection": true,
  "code-runner.fileDirectoryAsCwd": false,
  "code-runner.executorMap": {"python": "\"$workspaceRoot/.venv/bin/python\" -u"},
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "tests", "-p", "test_langgraph_workflow.py"],
  "files.exclude": {"**/__pycache__": true, "**/*.egg-info": true},
  "search.exclude": {".venv": true, "outputs": true, "artifacts": true}
}
